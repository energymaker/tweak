{
  "manifest_version": 3,
  "name": "Tweak bar",
  "version": "1.0.0",
  "description": "Press a shortcut on any page, say what you want changed, watch it happen. Works with the Tweak app on this computer.",
  "permissions": [
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "bar.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "commands": {
    "open-bar": {
      "suggested_key": {
        "default": "Alt+Shift+T"
      },
      "description": "Ask Tweak to change this page"
    }
  },
  "action": {
    "default_title": "Ask Tweak to change this page"
  }
}